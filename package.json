{
  "name": "personalwebsite",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && cp dist/index.html dist/404.html",
    "postbuild": "node scripts/check-build.mjs",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.6.0",
    "flag-icons": "^7.5.0",
    "pinia": "^2.1.7",
    "vue": "^3.4.29",
    "vue-i18n": "^11.4.12",
    "vue-router": "^4.3.3",
    "vue3-lazyload": "^0.3.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/server-renderer": "^3.5.45",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "vite": "^7.3.6",
    "vitest": "^5.1.0"
  }
}
